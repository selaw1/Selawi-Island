# Selawi Island, built from this repository (no download, no hosting).
# Build and install from this folder:  makepkg -si   (or: yay -Bi .)
# Usually run for you by selawi-island-update.
# Only committed changes are built (makepkg clones the repository).

pkgname=selawi-island
pkgver=0.1.0
pkgrel=1
pkgdesc='Dynamic Island-style activity center for GNOME: calls, media, devices, notifications'
arch=('x86_64' 'aarch64')
license=('LicenseRef-private')
depends=('gnome-shell' 'dbus' 'systemd' 'glib2' 'gcc-libs' 'gjs' 'gtk4' 'libadwaita')
makedepends=('git' 'rust' 'nodejs' 'pnpm' 'python')
optdepends=(
    'gst-plugins-good: voice waves while the microphone is in use'
    'python-gobject: the Python plugin helper (import selawi_island)'
    'google-chrome: browser integration (calls, media tabs, downloads)'
    'chromium: browser integration (calls, media tabs, downloads)'
    'firefox: browser integration (calls, media tabs, downloads)'
)
options=('!lto' '!debug')
source=("$pkgname::git+file://$(realpath "$startdir/../..")")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    local base
    base=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
    printf '%s.r%s.g%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# Downloads use your normal Cargo cache (~/.cargo) and the compiled
# output is kept in ~/.cache/selawi-island, so an update downloads
# nothing new and only rebuilds what changed.
_target="${XDG_CACHE_HOME:-$HOME/.cache}/selawi-island/target"

prepare() {
    cd "$pkgname"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname"
    export CARGO_TARGET_DIR="$_target"
    cargo build --release --frozen -p selawi-islandd -p selawi-island -p selawi-island-browser-host
    ./scripts/build-browser.sh
}

package() {
    cd "$pkgname"
    CARGO_TARGET_DIR="$_target" ./scripts/stage-package.sh "$pkgdir"
}
