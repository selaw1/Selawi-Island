[Unit]
Description=Selawi Island event daemon
Documentation=file://%h/.local/share/doc/selawi-island/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=com.selawi.Island
ExecStart=%h/.local/bin/selawi-islandd
Restart=on-failure
RestartSec=2

# The daemon only needs the session bus and its state file.
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
