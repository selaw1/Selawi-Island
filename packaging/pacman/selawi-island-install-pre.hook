# Shows installs, updates and removals (pacman, yay) in Selawi Island.
# It only sends one short message to the island; it can never stop or
# slow down the transaction (it always succeeds and gives up after ~1 s).
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Telling Selawi Island...
When = PreTransaction
Exec = /usr/bin/selawi-island pacman-hook pre install
NeedsTargets
